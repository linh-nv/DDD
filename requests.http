POST {{base}}/exams/submit-ddd
Content-Type: application/json

{
    "exam_id": 1,
    "answers": {
        "1": false,
        "2": "B",
        "3": "laravel",
        "4": {
            "PHP": "Backend",
            "Vue": "Frontend",
            "Redis": "Cache"
        },
        "5": ["A", "B", "D"],
        "6": ["Request", "Kernel", "Middleware", "Router", "Controller", "Response"],
        "7": {
            "Vue": "Frontend",
            "React": "Frontend",
            "Laravel": "Backend",
