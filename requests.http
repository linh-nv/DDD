### Base URL
@base = http://localhost:8000/api

# =============================================================
# SUBMIT EXAM — MVP version  (POST /api/exams/submit)
# =============================================================

### Submit all question types (MVP)
POST {{base}}/exams/submit
Content-Type: application/json

{
    "exam_id": 1,
    "answers": {
        "1": false,
        "2": "B",
        "3": "laravel",
        "4": {
            "PHP": "Backend",
            "Vue": "Frontend",
            "Redis": "Cache"
        },
        "5": ["A", "B", "D"],
        "6": ["Request", "Kernel", "Middleware", "Router", "Controller", "Response"],
        "7": {
            "Vue": "Frontend",
            "React": "Frontend",
            "Laravel": "Backend",
            "MySQL": "Database",
            "Redis": "Database"
        }
    }
}

###

### Submit — partial answers (some wrong)
POST {{base}}/exams/submit
Content-Type: application/json

{
    "exam_id": 1,
    "answers": {
        "1": true,
        "2": "A",
        "3": "symfony",
        "4": {
            "PHP": "Frontend",
            "Vue": "Backend",
            "Redis": "Cache"
        },
        "5": ["A", "C"],
        "6": ["Kernel", "Request", "Middleware", "Router", "Controller", "Response"],
        "7": {
            "Vue": "Backend",
            "React": "Frontend",
            "Laravel": "Backend",
            "MySQL": "Frontend",
            "Redis": "Database"
        }
    }
}

